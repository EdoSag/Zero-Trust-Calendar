<?xml version="1.0" encoding="utf-8"?>
<!-- Resizable from 2x1 (title, + and a count) up to the whole screen; more
     events show as it grows. See UpNextWidgetProvider. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_up_next"
    android:previewLayout="@layout/widget_up_next_preview"
    android:description="@string/up_next_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
