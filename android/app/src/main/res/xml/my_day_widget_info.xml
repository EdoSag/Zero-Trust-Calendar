<?xml version="1.0" encoding="utf-8"?>
<!-- Resizable from 2x2 (the next event and a count of tasks) up to the
     whole screen; more of today's tasks show as it grows. See
     MyDayWidgetProvider. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_my_day"
    android:previewLayout="@layout/widget_my_day_preview"
    android:description="@string/my_day_widget_description"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen">
</appwidget-provider>
