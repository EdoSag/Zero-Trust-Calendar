<?xml version="1.0" encoding="utf-8"?>
<!--
  What the Widgets menu shows (Android 12+): sample events, never real ones.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/header_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/app_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/zt_widget_header_icon"
                    android:layout_height="@dimen/zt_widget_header_icon"
                    android:src="@mipmap/ic_launcher"
                    android:importantForAccessibility="no"/>
                <TextView
                    style="@style/ZtWidget.AppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="ZT Calendar"/>
            </LinearLayout>
            <TextView
                android:id="@+id/header_title"
                style="@style/ZtWidget.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/up_next_header"/>
            <TextView
                android:id="@+id/summary"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/up_next_preview_today"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/add_button"
            style="@style/ZtWidget.Action"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_zt_widget_add"
            android:contentDescription="@string/up_next_new_event"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/row0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="32dp">
        <ImageView
            android:id="@+id/dot0"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_dot"
            android:tint="#F97316"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/title0"
            style="@style/ZtWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/up_next_preview_standup"/>
        <TextView
            android:id="@+id/time0"
            style="@style/ZtWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="10:00"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="32dp">
        <ImageView
            android:id="@+id/dot1"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_dot"
            android:tint="#3B82F6"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/title1"
            style="@style/ZtWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/up_next_preview_lunch"/>
        <TextView
            android:id="@+id/time1"
            style="@style/ZtWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="13:30"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:minHeight="32dp">
        <ImageView
            android:id="@+id/dot2"
            android:layout_width="4dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/widget_dot"
            android:tint="#10B981"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/title2"
            style="@style/ZtWidget.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/up_next_preview_dentist"/>
        <TextView
            android:id="@+id/time2"
            style="@style/ZtWidget.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/up_next_preview_tomorrow"/>
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
