<?xml version="1.0" encoding="utf-8"?>
<!--
  What the Widgets menu shows (Android 12+) for "My day": sample content,
  never real events or tasks.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_preview_root"
    style="@style/ZtWidget.Root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/app_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="@dimen/zt_widget_header_icon"
                    android:layout_height="@dimen/zt_widget_header_icon"
                    android:src="@mipmap/ic_launcher"
                    android:importantForAccessibility="no"/>
                <TextView
                    style="@style/ZtWidget.AppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="ZT Calendar"/>
            </LinearLayout>
            <TextView
                android:id="@+id/header_title"
                style="@style/ZtWidget.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/my_day_header"/>
            <TextView
                android:id="@+id/date"
                style="@style/ZtWidget.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/my_day_preview_date"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/add_button"
            style="@style/ZtWidget.Action"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_zt_widget_add"
            android:contentDescription="@string/up_next_new_event"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/next_label"
            style="@style/ZtWidget.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_day_next"/>
        <LinearLayout
            android:id="@+id/next_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="32dp">
            <ImageView
                android:id="@+id/next_dot"
                android:layout_width="4dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/widget_dot"
                android:importantForAccessibility="no"/>
            <TextView
                android:id="@+id/next_title"
                style="@style/ZtWidget.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/up_next_preview_standup"/>
            <TextView
                android:id="@+id/next_time"
                style="@style/ZtWidget.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="10:30"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tasks_label"
                    style="@style/ZtWidget.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/my_day_tasks"/>
                <TextView
                    android:id="@+id/overdue"
                    style="@style/ZtWidget.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/my_day_preview_overdue"/>
            </LinearLayout>
            <TextView
                android:id="@+id/tasks_summary"
                style="@style/ZtWidget.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="28dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/zt_widget_check_ring"
                    android:importantForAccessibility="no"/>
                <TextView
                    style="@style/ZtWidget.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/my_day_preview_task1"/>
                <TextView
                    style="@style/ZtWidget.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="17:00"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="28dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/zt_widget_check_ring"
                    android:importantForAccessibility="no"/>
                <TextView
                    style="@style/ZtWidget.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/my_day_preview_task2"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/locked"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_zt_widget_lock"
            android:tint="@color/zt_widget_on_surface_variant"
            android:importantForAccessibility="no"/>
        <TextView
            android:id="@+id/locked_text"
            style="@style/ZtWidget.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:maxLines="2"
            android:text="@string/my_day_open_app"/>
    </LinearLayout>
</LinearLayout>
